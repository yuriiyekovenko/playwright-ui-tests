{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": [
        "pages/**/*.ts",
        // "clients/**/*.ts",
        // "types/**/*.ts",
        // "factories/**/*.ts",
        "fixtures/**/*.ts",
        "config/**/*.ts",
        "tests/**/*.ts",
        "playwright.config.ts",
        "playwright.api.config.ts"
    ],
    "exclude": ["node_modules", "playwright-report", "test-results"]
}
